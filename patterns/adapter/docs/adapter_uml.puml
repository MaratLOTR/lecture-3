@startuml
left to right direction
Switchable <|-- ModernLight
Switchable <|-- LampObjectAdapter
Switchable <|-- LampClassAdapter
LegacyLamp <|-- LampClassAdapter
LampObjectAdapter --> LegacyLamp : lamp
Client --> Switchable
abstract class Switchable {
  set_power(enabled)
}
class Client {
  set_all_power()
}
class ModernLight {
  set_power(enabled)
}
class LampObjectAdapter {
  lamp: LegacyLamp
  set_power(enabled)
}
class LampClassAdapter {
  set_power(enabled)
}
class LegacyLamp {
  switch_on()
  switch_off()
}
@enduml

@startuml
participant "Client" as C
participant "LampObjectAdapter" as A
participant "LegacyLamp" as L
C -> A: set_power(True)
A -> L: switch_on()
C -> A: set_power(False)
A -> L: switch_off()
participant "LampClassAdapter" as K
C -> K: set_power(True)
K -> K: switch_on()
C -> K: set_power(False)
K -> K: switch_off()
@enduml
